# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Lanite runtime artifacts (large / machine-specific) ───────────────────────
# Whisper + silero-VAD model weights (multi-GB — downloaded on first run)
lanite/models/
# Local runtime config that ends up in %APPDATA%\Lanite is fine to omit,
# but ignore any stray copies that get created next to the source.
lanite/config.local.json
lanite/history.json
lanite/*.log

# ── Editor / OS junk ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ── Windows shortcut clutter that shouldn't be versioned ──────────────────────
*.lnk

# ── Local editor configuration ────────────────────────────────────────────────
.claude/

# ── Obsolete folder ignore ───────────────────────────────────────────────────
obsolete/


